<Window x:Class="WorkIntelligence.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="First-run Setup" Width="740" Height="590" MinWidth="640" MinHeight="500" WindowStartupLocation="CenterOwner">
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Set up your local work assistant" FontSize="23" FontWeight="Bold"/><TextBlock Text="Choose local storage and optional model, source and backup folders. All work data and backup copies are plaintext. Model inference stays local." TextWrapping="Wrap" Margin="0,8,0,12"/></StackPanel>
    <TabControl Grid.Row="1" x:Name="SetupSteps">
      <TabItem Header="1. Storage"><StackPanel Margin="16"><TextBlock Text="Local data folder (never a live OneDrive folder)"/><TextBox x:Name="SetupDataFolder" IsReadOnly="True" Margin="0,8"/><Button Content="Choose Data Folder" Click="ChooseData_Click" HorizontalAlignment="Left"/><TextBlock Text="Changing the data folder restarts the application. Existing data is preserved; use verified restore to transfer knowledge." TextWrapping="Wrap" Margin="0,15"/></StackPanel></TabItem>
      <TabItem Header="2. Models"><StackPanel Margin="16"><TextBlock Text="Download model weights to this folder"/><DockPanel Margin="0,8"><Button Content="Browse Models Folder" DockPanel.Dock="Right" Click="ChooseModels_Click"/><TextBox x:Name="SetupModelsFolder"/></DockPanel><TextBlock Text="Optional: register an existing GGUF file"/><DockPanel Margin="0,8"><Button Content="Choose GGUF" DockPanel.Dock="Right" Click="ChooseModel_Click"/><TextBox x:Name="SetupModelFile"/></DockPanel><TextBlock Text="You may finish without a model and import or download one later. Files stay external to the application. Import verifies the GGUF header and records its SHA-256." TextWrapping="Wrap"/></StackPanel></TabItem>
      <TabItem Header="3. Sources"><StackPanel Margin="16"><TextBlock Text="Optional organization-approved source folder"/><DockPanel Margin="0,8"><Button Content="Browse Sources" DockPanel.Dock="Right" Click="ChooseKnowledge_Click"/><TextBox x:Name="SetupKnowledgeFolder"/></DockPanel><TextBlock Text="Finishing setup imports supported top-level files and monitors this folder while the app runs. Leave blank to import individual approved documents later. Do not select restricted patient, employee or confidential records without specific authorization." TextWrapping="Wrap"/></StackPanel></TabItem>
      <TabItem Header="4. Backup"><StackPanel Margin="16"><TextBlock Text="Optional approved folder for an initial verified plaintext snapshot"/><DockPanel Margin="0,8"><Button Content="Browse Backup Folder" DockPanel.Dock="Right" Click="ChooseBackup_Click"/><TextBox x:Name="SetupBackupFolder"/></DockPanel><TextBlock Text="A snapshot will be created when setup finishes. No cloud account is connected and no scheduled task is installed by this wizard. Configure OneDrive and scheduling separately after opening the workspace." TextWrapping="Wrap"/></StackPanel></TabItem>
      <TabItem Header="5. Review"><StackPanel Margin="16"><TextBlock Text="Only use approved work data. This application does not encrypt its database, imported files, memories, indexes or backups. Microsoft Purview does not automatically protect these files." TextWrapping="Wrap"/><CheckBox x:Name="SetupAuthorization" Margin="0,18"><TextBlock Text="I confirm organizational authorization for the selected plaintext data, source and backup locations." TextWrapping="Wrap"/></CheckBox><TextBlock Text="Review the selected paths in the earlier steps before finishing. No download or remote upload happens automatically." TextWrapping="Wrap"/></StackPanel></TabItem>
    </TabControl>
    <TextBlock x:Name="SetupStatus" Grid.Row="2" TextWrapping="Wrap" Margin="0,10"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="SetupBack" Content="Back" Click="Back_Click" Margin="5" Padding="12,5"/><Button x:Name="SetupNext" Content="Next" Click="Next_Click" Margin="5" Padding="12,5"/><Button x:Name="SetupFinish" Content="Finish Setup" Click="Finish_Click" Margin="5" Padding="12,5"/><Button x:Name="SetupCancel" Content="Cancel Setup" Click="Cancel_Click" Margin="5" Padding="12,5"/></StackPanel>
  </Grid>
</Window>
