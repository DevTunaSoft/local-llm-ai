<Window x:Class="WorkIntelligence.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Work Intelligence AI" Height="850" Width="1220" MinWidth="850" MinHeight="610"
        Background="#F7F9FC" WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="WORK INTELLIGENCE AI" FontWeight="Bold" FontSize="24" Foreground="#173456"/>
      <TextBlock x:Name="HeaderState" Text="  •  Local only" VerticalAlignment="Center" Foreground="#52647A" FontSize="14"/>
    </DockPanel>
    <Border x:Name="UnlockPanel" Grid.Row="1" Background="White" Padding="30" CornerRadius="12" BorderThickness="1" BorderBrush="#D6DCE8">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="450">
        <TextBlock Text="Open your local work intelligence workspace" FontSize="24" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,10"/>
        <TextBlock Text="All local databases, imported attachments and backups are stored UNENCRYPTED. Use only with organizational authorization." TextWrapping="Wrap" Margin="0,0,0,15" Foreground="#52647A"/>
        <CheckBox x:Name="WorkAuthorizationCheck" Margin="0,0,0,12"><TextBlock TextWrapping="Wrap" Text="I confirm organizational approval for this plaintext work-data environment and will not import restricted patient or employee records."/></CheckBox>
        <Button Content="First-run Setup" Click="FirstRunSetup_Click" Margin="0,0,0,8"/>
        <Button x:Name="UnlockButton" Content="Open Local Workspace" Height="40" Click="Unlock_Click"/>
        <Separator Margin="0,15"/>
        <TextBlock Text="Restore a previous backup onto this empty computer" TextAlignment="Center"/>
        <Button Content="Restore Plaintext Snapshot" Click="Restore_Click"/>
        <TextBlock Text="Optional: configured rclone OneDrive remote folder (e.g., workonedrive:WIBackups)" TextWrapping="Wrap"/>
        <TextBox x:Name="RemoteRestoreText" Height="28"/>
        <Button Content="Restore from OneDrive" Click="RestoreOneDrive_Click"/>
        <TextBlock Text="No internet is required to open or use stored knowledge." Foreground="#52647A" TextAlignment="Center" Margin="0,14,0,0"/>
      </StackPanel>
    </Border>
    <TabControl x:Name="MainTabs" Grid.Row="1" Visibility="Collapsed" BorderBrush="#D6DCE8" Background="White">
      <TabItem Header="AI Chat">
        <Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal"><Button Content="New Chat" Click="NewChat_Click"/><Button Content="Delete" Click="DeleteChat_Click"/><Button Content="Export" Click="ExportChat_Click"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,6,0,6"><TextBox x:Name="ChatTitleInput" MinWidth="130" MaxLength="120" ToolTip="Conversation title"/><Button Content="Rename Chat" Click="RenameChat_Click"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBox x:Name="ChatSearchInput" MinWidth="105" MaxLength="200" ToolTip="Search conversation titles and messages"/><Button Content="Search Chats" Click="SearchChats_Click"/><Button Content="All" Click="ClearChatSearch_Click"/></StackPanel></StackPanel>
            <ListBox x:Name="ChatList" DisplayMemberPath="Title" SelectionChanged="ChatList_SelectionChanged"/>
          </DockPanel>
          <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="110"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,0,0,6">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Model:" VerticalAlignment="Center"/>
                <ComboBox x:Name="ChatModelBox" Width="300" DisplayMemberPath="DisplayName" Margin="7,0" SelectionChanged="ChatModelBox_SelectionChanged"/>
                <Button Content="Load Model" Click="LoadModel_Click"/>
                <Button Content="Stop Model" Click="StopModel_Click"/>
              </StackPanel>
              <WrapPanel Margin="0,5,0,0" VerticalAlignment="Center">
                <TextBlock Text="Context:" VerticalAlignment="Center"/>
                <TextBox x:Name="ModelContextInput" Width="65" Text="4096" Margin="4,0,10,0"/>
                <TextBlock Text="CPU threads:" VerticalAlignment="Center"/>
                <TextBox x:Name="ModelThreadsInput" Width="45" Text="8" Margin="4,0,10,0"/>
                <TextBlock Text="Max tokens:" VerticalAlignment="Center"/>
                <TextBox x:Name="ModelMaxTokensInput" Width="65" Text="1024" Margin="4,0,10,0"/>
                <TextBlock Text="Temperature:" VerticalAlignment="Center"/>
                <TextBox x:Name="ModelTemperatureInput" Width="45" Text="0.7" Margin="4,0,10,0"/>
                <TextBlock Text="Load timeout (s):" VerticalAlignment="Center"/>
                <TextBox x:Name="ModelStartupTimeoutInput" Width="55" Text="900" Margin="4,0,10,0"/>
                <TextBlock Text="Response timeout (s):" VerticalAlignment="Center"/>
                <TextBox x:Name="ModelResponseTimeoutInput" Width="55" Text="600" Margin="4,0,10,0"/>
                <Button Content="Save Model Settings" Click="SaveModelSettings_Click"/>
              </WrapPanel>
            </StackPanel>
            <TextBox x:Name="ChatHistory" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="14" Background="#FAFCFF"/>
            <TextBox x:Name="ChatInput" Grid.Row="2" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="14"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="SendButton" Content="Send" Width="100" Click="Send_Click"/><Button Content="Stop Response" Click="StopResponse_Click"/></StackPanel>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Knowledge Library">
        <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="180"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal"><Button Content="Import Documents" Click="ImportDocs_Click"/><Button Content="Compare Two Selected" Click="CompareDocuments_Click"/><Button Content="Load Semantic Model" Click="StartSemantic_Click"/><Button Content="Build Semantic Index" Click="ReindexSemantic_Click"/><Button Content="Delete Selected Version" Click="DeleteDoc_Click"/><Button Content="Refresh" Click="Refresh_Click"/><Button Content="Approve Folder for Monitoring" Click="AddWatchFolder_Click"/><Button Content="Scan Approved Folders" Click="ScanFolders_Click"/></StackPanel>
          <ListBox x:Name="DocumentList" Grid.Row="1" DisplayMemberPath="Name" SelectionMode="Extended"/>
          <TextBlock Grid.Row="2" Text="Search locally indexed document text" FontWeight="SemiBold" Margin="3,12,3,2"/>
          <DockPanel Grid.Row="3"><Button DockPanel.Dock="Right" Content="Search" Click="SearchDocs_Click"/><TextBox x:Name="SearchInput"/></DockPanel>
          <TextBox x:Name="SearchResults" Grid.Row="4" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
        </Grid>
      </TabItem>
      <TabItem Header="Approved Memories">
        <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="110"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Only memories you explicitly approve here are stored. Do not enter restricted or patient data." Margin="3,5" TextWrapping="Wrap"/>
          <ListBox x:Name="MemoryList" Grid.Row="1" DisplayMemberPath="Text"/>
          <TextBox x:Name="MemoryInput" Grid.Row="2" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
          <StackPanel Grid.Row="3" Orientation="Horizontal"><Button Content="Review Proposals" Click="ReviewProposals_Click"/><Button Content="Approve and Save Memory" Click="AddMemory_Click"/><Button Content="Propose Correction to Selected" Click="ProposeCorrection_Click"/><Button Content="Memory History" Click="MemoryHistory_Click"/><Button Content="Delete Selected Memory" Click="DeleteMemory_Click"/><Button Content="Export Memories" Click="ExportMemories_Click"/></StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Model Manager">
        <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="190"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal"><Button Content="Import GGUF" Click="ImportModel_Click"/><Button Content="Benchmark Selected" Click="BenchmarkModel_Click"/><Button Content="Compare Two Models" Click="CompareModels_Click"/><Button Content="Load Selected" Click="LoadModel_Click"/><Button Content="Remove from Library" Click="RemoveModel_Click"/></StackPanel>
          <ListBox x:Name="ModelList" Grid.Row="1" DisplayMemberPath="DisplayName" SelectionChanged="ModelList_SelectionChanged"/>
          <TextBlock Grid.Row="2" Text="Verified model download (trusted SHA-256 required)" FontWeight="Bold" Margin="3,10,3,3"/>
          <TextBox Grid.Row="3" x:Name="ModelUrl" ToolTip="HTTPS URL under huggingface.co"/>
          <TextBox Grid.Row="4" x:Name="ModelFilename" ToolTip="Destination filename ending in .gguf"/>
          <TextBox Grid.Row="5" x:Name="ModelSha" ToolTip="Expected SHA-256 from a trusted source"/>
          <StackPanel Grid.Row="6" Orientation="Vertical"><Button Content="Download and Verify Model" HorizontalAlignment="Left" Click="DownloadModel_Click"/><TextBlock Text="Download occurs only on explicit request. Model weights are not embedded in the EXE." Foreground="#52647A"/></StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Workspaces &amp; Projects">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="130"/><RowDefinition Height="Auto"/><RowDefinition Height="130"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal"><TextBox x:Name="WorkspaceNameInput" MinWidth="270" ToolTip="New workspace name"/><Button Content="Create Workspace" Click="CreateWorkspace_Click"/><Button Content="Assign Selected Library Document" Click="AssignDocument_Click"/></StackPanel>
          <ListBox Grid.Row="1" x:Name="WorkspaceList" DisplayMemberPath="Name" SelectionChanged="WorkspaceChanged_Click"/>
          <StackPanel Grid.Row="2" Orientation="Horizontal"><TextBox x:Name="TaskTitleInput" MinWidth="300" ToolTip="Task title"/><Button Content="Add Task" Click="AddTask_Click"/><Button Content="Save Selected Task" Click="SaveTask_Click"/><Button Content="Mark Completed" Click="CompleteTask_Click"/></StackPanel>
          <ListBox Grid.Row="3" x:Name="TaskList" DisplayMemberPath="Title" SelectionChanged="TaskList_SelectionChanged"/>
          <TextBlock Grid.Row="4" Text="Task details / project decision (stored locally without encryption)"/>
          <TextBox Grid.Row="5" x:Name="TaskDetailsInput" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        </Grid>
      </TabItem>
      <TabItem Header="Document Studio">
        <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal"><Button Content="Use Current Conversation" Click="DraftFromChat_Click"/><Button Content="Export Word DOCX" Click="ExportDocx_Click"/><Button Content="Export PDF" Click="ExportPdf_Click"/></StackPanel>
          <TextBox Grid.Row="1" x:Name="DocumentTitleInput" Text="Work Intelligence Report" Height="32"/>
          <TextBox Grid.Row="2" x:Name="DocumentDraftInput" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </Grid>
      </TabItem>
      <TabItem Header="Backup / Recovery">
        <StackPanel Margin="20" MaxWidth="800">
          <TextBlock Text="Plaintext versioned backups" FontWeight="Bold" FontSize="19" Margin="0,0,0,10"/>
          <TextBlock Text="Backups are NOT encrypted. Use only a company-approved backup destination; Purview labels do not automatically secure this app's database or backups." TextWrapping="Wrap" Margin="0,0,0,12"/>
          <TextBlock Text="Repository folder" FontWeight="SemiBold"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse" Click="BrowseBackup_Click"/><TextBox x:Name="BackupFolder"/></DockPanel>
          <Button Content="Create and Verify Plaintext Snapshot" HorizontalAlignment="Left" Click="Backup_Click"/>
          <TextBlock Text="Configured rclone OneDrive remote folder (e.g., workonedrive:WIBackups)" Margin="0,12,0,0"/>
          <Button Content="Configure OneDrive Account (interactive OAuth)" HorizontalAlignment="Left" Click="ConfigureOneDrive_Click" ToolTip="Opens bundled rclone configuration; requires organizational approval and an interactive Microsoft sign-in"/>
          <TextBox x:Name="RemoteBackupText" Height="28"/>
          <Button Content="Sync + Byte-Verify Plaintext OneDrive Backup" Click="SyncOneDrive_Click" HorizontalAlignment="Left"/>
          <TextBlock Text="Optional local snapshot retention: leave blank to keep all. Enter 2 or more to preserve at least that many verified backups. Corrupt snapshots are never deleted automatically." TextWrapping="Wrap" Margin="0,12,0,3"/>
          <TextBox x:Name="BackupKeepCountInput" Width="90" HorizontalAlignment="Left" MaxLength="5" ToolTip="Optional number of newest verified snapshots to preserve; blank keeps all"/>
          <TextBlock Text="Optional daily backup (2 AM). Schedule and copied data contain no application-layer encryption." TextWrapping="Wrap" Margin="0,15,0,0"/>
          <StackPanel Orientation="Horizontal"><Button Content="Enable Daily Backup (2 AM)" Click="ScheduleBackup_Click"/><Button Content="Disable Daily Backup" Click="RemoveScheduledBackup_Click"/></StackPanel>
          <TextBlock Text="Scheduled jobs run only while this Windows user is signed in. OneDrive access requires a separately configured authorized rclone remote; actual Windows/remote validation is pending." Foreground="#9C4B19" TextWrapping="Wrap" Margin="0,15,0,0"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Diagnostics">
        <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal"><Button Content="Run Local Checks" Click="Diagnostics_Click"/><Button Content="Open Local Log Folder" Click="OpenLogs_Click"/></StackPanel>
          <TextBox x:Name="DiagnosticsOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
        </Grid>
      </TabItem>
      <TabItem Header="Project Records">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="Records use the workspace selected under Workspaces &amp; Projects. Changes retain prior revisions and your reason." TextWrapping="Wrap"/>
          <ListBox x:Name="WorkRecordList" Grid.Row="1" DisplayMemberPath="Title" SelectionChanged="WorkRecordList_SelectionChanged"/>
          <WrapPanel Grid.Row="2"><TextBlock Text="Type:" VerticalAlignment="Center"/><ComboBox x:Name="WorkKindBox" Width="110"/><TextBlock Text="Status:" VerticalAlignment="Center"/><ComboBox x:Name="WorkStatusBox" Width="110"/><TextBlock Text="Owner:" VerticalAlignment="Center"/><TextBox x:Name="WorkOwnerInput" Width="180" MaxLength="200"/><TextBlock Text="Due:" VerticalAlignment="Center"/><DatePicker x:Name="WorkDueInput" Width="130"/></WrapPanel>
          <TextBox x:Name="WorkTitleInput" Grid.Row="3" MaxLength="200" ToolTip="Record title"/>
          <DockPanel Grid.Row="4"><TextBlock Text="Related project or prior case:" VerticalAlignment="Center"/><ComboBox x:Name="WorkRelatedBox" Width="300" DisplayMemberPath="Title"/><Button Content="Clear Link" Click="ClearWorkLink_Click"/></DockPanel>
          <TextBox x:Name="WorkDetailsInput" Grid.Row="5" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="20000"/>
          <StackPanel Grid.Row="6"><TextBlock Text="Reason for this revision / decision rationale"/><TextBox x:Name="WorkReasonInput" MaxLength="2000"/><WrapPanel><Button Content="New Record" Click="NewWorkRecord_Click"/><Button Content="Save Record" Click="SaveWorkRecord_Click"/><Button Content="Revision History" Click="WorkHistory_Click"/></WrapPanel></StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
    <TextBlock x:Name="StatusText" Grid.Row="2" Text="Workspace closed" Margin="2,10,0,0" FontSize="12" Foreground="#52647A"/>
  </Grid>
</Window>
