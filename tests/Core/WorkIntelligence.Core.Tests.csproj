<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <!-- Execute the production services directly, without loading Windows WPF. -->
    <Compile Include="../../WorkIntelligence/Services/*.cs" Exclude="../../WorkIntelligence/Services/ScheduledBackup.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../../WorkIntelligence/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../Tests.cs" Link="OriginalTests.cs" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="PdfPig" Version="0.1.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
  </ItemGroup>
</Project>
